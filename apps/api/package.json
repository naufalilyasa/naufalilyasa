{
  "name": "api",
  "version": "1.0.0",
  "description": "Naufal Ilyasa's Web Backend Portfolio",
  "keywords": [
    "Naufal",
    "Ilyasa",
    "Portfolio"
  ],
  "license": "ISC",
  "author": "Achmad Naufal Ilyasa",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "prebuild": "prisma generate && pnpm turbo run build --filter=@repo/types... --filter=@repo/zod-schemas...",
    "build": "tsc && pnpm run copy:prisma",
    "copy:prisma": "cp -r src/generated dist/src/generated",
    "dev": "pnpm dlx tsx --watch src/server.ts",
    "start": "node dist/src/server.js",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@prisma/client-runtime-utils": "^7.4.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.23",
    "module-alias": "^2.3.4",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "remeda": "^2.33.6",
    "serverless-http": "^4.0.0",
    "slugify": "^1.6.6",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/zod-schemas": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.1",
    "eslint-plugin-perfectionist": "^5.6.0",
    "morgan": "^1.10.1",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}